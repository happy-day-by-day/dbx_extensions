index 0000000..6ae9c0a
--- /dev/null
+++ b/apps/desktop/src/lib/plugins/pluginDirectory.ts
@@ -0,0 +1,10 @@
+import type { PluginDirectoryOperation, PluginDirectoryRequest } from "@/types/pluginDirectory";
+import { invoke } from "@tauri-apps/api/core";
+
+// Only the trusted workbench host imports these. No path-based open command.
+export function requestPluginDirectory(pluginId: string, options: PluginDirectoryRequest) {
+  return invoke("plugin_directory_request", { pluginId, options });
+}
+export function callPluginDirectory(pluginId: string, operation: PluginDirectoryOperation, params: Record<string, unknown>) {
+  return invoke("plugin_directory_call", { pluginId, operation, params });
+}
