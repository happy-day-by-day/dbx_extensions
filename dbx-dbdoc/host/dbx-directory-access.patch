+//! Test-only JSON-lines driver for exercising the real directory core without
+//! opening the GUI. The picker result is supplied by the test process argv.
+use dbx_directory_access::DirectoryService;
+use serde_json::{json, Value};
+use std::io::{self, BufRead};
+fn main() {
+    let args = std::env::args().collect::<Vec<_>>();
+    let mut service = DirectoryService::open(args[1].clone().into()).unwrap();
+    for line in io::stdin().lock().lines() {
+        let request: Value = serde_json::from_str(&line.unwrap()).unwrap();
+        let params = request.get("params").cloned().unwrap_or_else(|| json!({}));
+        let result = if request["operation"] == "request" {
+            service.grant("repro", std::path::Path::new(&args[2]), "readwrite")
+        } else {
+            service.call("repro", request["operation"].as_str().unwrap(), &params)
+        };
+        println!(
+            "{}",
+            match result {
+                Ok(value) => json!({"id":request["id"],"result":value}),
+                Err(error) => json!({"id":request["id"],"error":error}),
+            }
+        );
+    }
+}
diff --git a/crates/dbx-directory-access/src/lib.rs b/crates/dbx-directory-access/src/lib.rs
new file mode 100644
index 0000000..f60d9a2
--- /dev/null
+++ b/crates/dbx-directory-access/src/lib.rs
@@ -0,0 +1,698 @@
+//! Host-owned persistent directory capabilities. No plugin business data lives here.
+//! Call under a single host mutex, including revoke/commit. Only the native picker
+//! may supply `grant`'s root. Plugin calls take opaque grants and relative paths.
+use base64::{engine::general_purpose::STANDARD, Engine};
+use cap_std::{
+    ambient_authority,
+    fs::{Dir, OpenOptions},
+};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::HashMap,
+    fs::File,
+    io::{Read, Seek, SeekFrom, Write},
+    path::{Path, PathBuf},
+    time::{Duration, Instant},
+};
+use uuid::Uuid;
+
+pub const CHUNK: usize = 512 * 1024;
+pub const MAX_FILE: u64 = 512 * 1024 * 1024;
+const TTL: Duration = Duration::from_secs(600);
+type Result<T> = std::result::Result<T, String>;
+fn fail(code: &str, message: impl std::fmt::Display) -> String {
+    format!("[{code}] {message}")
+}
+fn io(error: std::io::Error) -> String {
+    let code = match error.kind() {
+        std::io::ErrorKind::NotFound => "NOT_FOUND",
+        std::io::ErrorKind::PermissionDenied => "ACCESS_DENIED",
+        _ if error.raw_os_error() == Some(28) || (cfg!(windows) && error.raw_os_error() == Some(112)) => "DISK_FULL",
+        _ => "IO_ERROR",
+    };
+    fail(code, error)
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Grant {
+    id: String,
+    owner: String,
+    identity: String,
+    root: PathBuf,
+    mode: String,
+    created_at: u64,
+    revoked: bool,
+    #[serde(default)]
+    preferred: bool,
+}
+struct Stream {
+    owner: String,
+    grant: String,
+    touched: Instant,
+    file: File,
+    size: u64,
+    write: Option<Staged>,
+}
+struct Staged {
+    parent: Dir,
+    temporary: String,
+    target: String,
+    expected: Option<String>,
+    parent_identity: String,
+    parent_path: String,
+}
+impl Drop for Stream {
+    fn drop(&mut self) {
+        if let Some(w) = &self.write {
+            let _ = w.parent.remove_file(&w.temporary);
+        }
+    }
+}
+pub struct DirectoryService {
+    store: PathBuf,
+    grants: Vec<Grant>,
+    streams: HashMap<String, Stream>,
+}
+impl DirectoryService {
+    pub fn open(store: PathBuf) -> Result<Self> {
+        let grants = match std::fs::read(&store) {
+            Ok(bytes) => serde_json::from_slice::<Vec<Grant>>(&bytes).map_err(|e| fail("GRANT_STORE_INVALID", e))?,
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => vec![],
+            Err(e) => return Err(io(e)),
+        };
+        Ok(Self { store, grants, streams: HashMap::new() })
+    }
+    /// Trusted host administration (never exported through the plugin bridge).
+    pub fn inspect_grants(&self) -> Vec<(String, Value)> {
+        self.grants.iter().filter(|g| !g.revoked).map(|g| (g.owner.clone(), Self::info(g, "unchecked"))).collect()
+    }
+    fn persist(&self) -> Result<()> {
+        let parent = self.store.parent().ok_or_else(|| fail("IO_ERROR", "invalid grant store"))?;
+        std::fs::create_dir_all(parent).map_err(io)?;
+        let mut tmp = tempfile::NamedTempFile::new_in(parent).map_err(io)?;
+        tmp.write_all(&serde_json::to_vec(&self.grants).map_err(|e| fail("IO_ERROR", e))?).map_err(io)?;
+        tmp.as_file().sync_all().map_err(io)?;
+        tmp.persist(&self.store).map_err(|e| io(e.error))?;
+        Ok(())
+    }
+    /// `owner` is host-derived plugin id + install provenance, never plugin input.
+    pub fn grant(&mut self, owner: &str, root: &Path, mode: &str) -> Result<Value> {
+        if !matches!(mode, "read" | "readwrite") {
+            return Err(fail("INVALID_ARGUMENT", "invalid access mode"));
+        }
+        let root = std::fs::canonicalize(root).map_err(io)?;
+        if self.store.starts_with(&root) {
+            return Err(fail("ACCESS_DENIED", "choose a directory outside the host authorization store"));
+        }
+        if self.grants.iter().filter(|g| g.owner == owner && !g.revoked).count() >= 64 {
+            return Err(fail("BUSY", "revoke an unused directory before granting another"));
+        }
+        let dir = Dir::open_ambient_dir(&root, ambient_authority()).map_err(io)?;
+        let identity = identity(&dir)?;
+        // Re-selecting an existing directory is explicit reauthorization, but
+        // creates a fresh grant so in-flight handles cannot inherit new consent.
+        let grant = Grant {
+            id: Uuid::new_v4().to_string(),
+            owner: owner.into(),
+            identity,
+            root,
+            mode: mode.into(),
+            created_at: std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap_or_default()
+                .as_secs(),
+            revoked: false,
+            preferred: false,
+        };
+        self.grants.push(grant.clone());
+        if let Err(e) = self.persist() {
+            self.grants.pop();
+            return Err(e);
+        }
+        Ok(Self::info(&grant, "ready"))
+    }
+    fn info(g: &Grant, status: &str) -> Value {
+        json!({"id":g.id,"displayName":g.root.file_name().unwrap_or_default().to_string_lossy(),
+            "displayPath":g.root.to_string_lossy(),"mode":g.mode,"status":status,
+            "persistent":true,"preferred":g.preferred,"createdAt":g.created_at,"chunkBytes":CHUNK,"maxFileBytes":MAX_FILE})
+    }
+    fn owned(&self, owner: &str, id: &str) -> Result<Grant> {
+        self.grants
+            .iter()
+            .find(|g| g.id == id && g.owner == owner)
+            .cloned()
+            .ok_or_else(|| fail("NEEDS_AUTHORIZATION", "unknown directory grant"))
+    }
+    fn root(&self, owner: &str, id: &str, write: bool) -> Result<Dir> {
+        let grant = self.owned(owner, id)?;
+        if grant.revoked {
+            return Err(fail("REVOKED", "directory grant revoked"));
+        }
+        if write && grant.mode != "readwrite" {
+            return Err(fail("READ_ONLY", "directory grant is read-only"));
+        }
+        let dir = Dir::open_ambient_dir(&grant.root, ambient_authority()).map_err(|e| fail("UNAVAILABLE", e))?;
+        if identity(&dir)? != grant.identity {
+            return Err(fail("IDENTITY_CHANGED", "selected directory was replaced; select it again"));
+        }
+        Ok(dir)
+    }
+    pub fn call(&mut self, owner: &str, operation: &str, p: &Value) -> Result<Value> {
+        self.streams.retain(|_, s| s.touched.elapsed() < TTL);
+        if operation == "listGrants" {
+            return Ok(Value::Array(
+                self.grants
+                    .iter()
+                    .filter(|g| g.owner == owner)
+                    .map(|g| Self::info(g, if g.revoked { "revoked" } else { "unchecked" }))
+                    .collect(),
+            ));
+        }
+        if matches!(operation, "read" | "write" | "close" | "abort" | "commit") {
+            return self.stream(owner, operation, p);
+        }
+        let id = text(p, "grantId")?;
+        let grant = self.owned(owner, id)?;
+        if operation == "restore" {
+            let status = match self.root(owner, id, false) {
+                Ok(_) => "ready",
+                Err(e) if e.starts_with("[REVOKED]") => "revoked",
+                Err(e) if e.starts_with("[IDENTITY_CHANGED]") => "identityChanged",
+                Err(_) => "unavailable",
+            };
+            return Ok(Self::info(&grant, status));
+        }
+        if operation == "setPreferred" {
+            self.root(owner, id, false)?;
+            let previous = self.grants.iter().map(|g| g.preferred).collect::<Vec<_>>();
+            for g in &mut self.grants {
+                if g.owner == owner {
+                    g.preferred = g.id == id;
+                }
+            }
+            if let Err(error) = self.persist() {
+                for (g, preferred) in self.grants.iter_mut().zip(previous) {
+                    g.preferred = preferred;
+                }
+                return Err(error);
+            }
+            return Ok(Value::Null);
+        }
+        if operation == "revoke" {
+            let index = self.grants.iter().position(|g| g.id == id && g.owner == owner).unwrap();
+            let old = self.grants[index].revoked;
+            self.grants[index].revoked = true;
+            if let Err(e) = self.persist() {
+                self.grants[index].revoked = old;
+                return Err(e);
+            }
+            self.streams.retain(|_, s| s.grant != id);
+            return Ok(Value::Null);
+        }
+        let root = self.root(owner, id, matches!(operation, "beginWrite" | "mkdir"))?;
+        let path = relative(p.get("path").and_then(Value::as_str).unwrap_or(""), matches!(operation, "list"))?;
+        match operation {
+            "list" => {
+                let cursor = p.get("cursor").and_then(Value::as_str).unwrap_or("");
+                let dir = if path.is_empty() { root } else { root.open_dir(&path).map_err(io)? };
+                // Bounded page memory: keep only the first 501 names after cursor.
+                let mut names = std::collections::BTreeMap::new();
+                for entry in dir.entries().map_err(io)? {
+                    let entry = entry.map_err(io)?;
+                    let Some(name) = entry.file_name().to_str().map(str::to_owned) else { continue };
+                    if name.as_str() <= cursor || name.starts_with(".dbx-write-") {
+                        continue;
+                    }
+                    let kind = entry.file_type().map_err(io)?;
+                    if kind.is_symlink() {
+                        continue;
+                    }
+                    names
+                        .insert(name.clone(), json!({"name":name,"kind":if kind.is_dir() {"directory"} else {"file"}}));
+                    if names.len() > 501 {
+                        names.pop_last();
+                    }
+                }
+                let more = names.len() > 500;
+                if more {
+                    names.pop_last();
+                }
+                let next = if more { names.last_key_value().map(|(k, _)| k.clone()) } else { None };
+                Ok(json!({"entries":names.into_values().collect::<Vec<_>>(),"cursor":next}))
+            }
+            "stat" => Ok(json!({"etag":etag(&root, &path)?})),
+            "mkdir" => {
+                root.create_dir(&path).map_err(io)?;
+                Ok(Value::Null)
+            }
+            "openRead" => {
+                self.room(owner)?;
+                let mut file = open_regular(&root, &path)?;
+                if !file.metadata().map_err(io)?.is_file() {
+                    return Err(fail("INVALID_ARGUMENT", "not a regular file"));
+                }
+                let size = file.metadata().map_err(io)?.len();
+                if size > MAX_FILE {
+                    return Err(fail("TOO_LARGE", "file exceeds size limit"));
+                }
+                let etag = hash_file(&mut file)?;
+                file.seek(SeekFrom::Start(0)).map_err(io)?;
+                let handle = Uuid::new_v4().to_string();
+                self.streams.insert(
+                    handle.clone(),
+                    Stream { owner: owner.into(), grant: id.into(), touched: Instant::now(), file, size, write: None },
+                );
+                Ok(json!({"handleId":handle,"size":size,"etag":etag,"chunkBytes":CHUNK}))
+            }
+            "beginWrite" => {
+                self.room(owner)?;
+                let expected = match p.get("expectedEtag") {
+                    Some(Value::Null) => None,
+                    Some(Value::String(v)) => Some(v.clone()),
+                    _ => return Err(fail("INVALID_ARGUMENT", "expectedEtag is required; null means create only")),
+                };
+                if etag(&root, &path)? != expected {
+                    return Err(fail("CONFLICT", "file changed before write"));
+                }
+                let (parent_path, target) = path.rsplit_once('/').unwrap_or(("", path.as_str()));
+                let parent = if parent_path.is_empty() {
+                    root.try_clone().map_err(io)?
+                } else {
+                    root.open_dir(parent_path).map_err(io)?
+                };
+                let parent_identity = identity(&parent)?;
+                let handle = Uuid::new_v4().to_string();
+                let temporary = format!(".dbx-write-{handle}");
+                let mut options = OpenOptions::new();
+                options.write(true).create_new(true);
+                #[cfg(unix)]
+                {
+                    use cap_std::fs::OpenOptionsExt;
+                    options.mode(0o600);
+                }
+                let file = parent.open_with(&temporary, &options).map_err(io)?.into_std();
+                self.streams.insert(
+                    handle.clone(),
+                    Stream {
+                        owner: owner.into(),
+                        grant: id.into(),
+                        touched: Instant::now(),
+                        file,
+                        size: 0,
+                        write: Some(Staged {
+                            parent,
+                            temporary,
+                            target: target.into(),
+                            expected,
+                            parent_identity,
+                            parent_path: parent_path.into(),
+                        }),
+                    },
+                );
+                Ok(json!({"handleId":handle,"chunkBytes":CHUNK}))
+            }
+            _ => Err(fail("UNSUPPORTED", "unknown directory operation")),
+        }
+    }
+    fn room(&self, owner: &str) -> Result<()> {
+        if self.streams.len() >= 128 || self.streams.values().filter(|s| s.owner == owner).count() >= 16 {
+            return Err(fail("BUSY", "too many open directory handles"));
+        }
+        Ok(())
+    }
+    fn stream(&mut self, owner: &str, operation: &str, p: &Value) -> Result<Value> {
+        let id = text(p, "handleId")?;
+        let s = self
+            .streams
+            .get(id)
+            .filter(|s| s.owner == owner)
+            .ok_or_else(|| fail("INVALID_HANDLE", "unknown directory stream"))?;
+        if matches!(operation, "abort" | "close") {
+            self.streams.remove(id);
+            return Ok(Value::Null);
+        }
+        // Recheck the current grant/identity on every chunk and again at commit.
+        let root = self.root(owner, &s.grant, operation != "read")?;
+        if operation == "commit" {
+            let mut s = self.streams.remove(id).unwrap(); // Drop aborts on every failure.
+            let w = s.write.as_ref().ok_or_else(|| fail("INVALID_HANDLE", "not a write handle"))?;
+            let mut file = open_regular(&w.parent, &w.temporary)?;
+            if hash_file(&mut file)? != text(p, "sha256")? {
+                return Err(fail("CHECKSUM_MISMATCH", "incomplete or corrupt write"));
+            }
+            let parent = if w.parent_path.is_empty() { root } else { root.open_dir(&w.parent_path).map_err(io)? };
+            if identity(&parent)? != w.parent_identity {
+                return Err(fail("IDENTITY_CHANGED", "write parent moved"));
+            }
+            if etag(&parent, &w.target)? != w.expected {
+                return Err(fail("CONFLICT", "file changed during write"));
+            }
+            s.file.sync_all().map_err(io)?;
+            drop(file);
+            // cap-std uses handle-relative replacement, never truncate-before-write.
+            w.parent.rename(&w.temporary, &parent, &w.target).map_err(io)?;
+            let digest = text(p, "sha256")?.to_owned();
+            s.write = None;
+            return Ok(json!({"etag":digest,"committed":true}));
+        }
+        let s = self.streams.get_mut(id).unwrap();
+        s.touched = Instant::now();
+        let offset =
+            p.get("offset").and_then(Value::as_u64).ok_or_else(|| fail("INVALID_ARGUMENT", "offset required"))?;
+        if operation == "read" {
+            if s.write.is_some() || offset > s.size {
+                return Err(fail("INVALID_ARGUMENT", "invalid read"));
+            }
+            let length = p.get("length").and_then(Value::as_u64).unwrap_or(CHUNK as u64).min(CHUNK as u64);
+            s.file.seek(SeekFrom::Start(offset)).map_err(io)?;
+            let mut data = vec![0; length.min(s.size - offset) as usize];
+            s.file.read_exact(&mut data).map_err(io)?;
+            return Ok(
+                json!({"dataBase64":STANDARD.encode(&data),"length":data.len(),"eof":offset + data.len() as u64 == s.size}),
+            );
+        }
+        if s.write.is_none() || offset != s.size {
+            return Err(fail("INVALID_ARGUMENT", "nonsequential write"));
+        }
+        let encoded = text(p, "dataBase64")?;
+        if encoded.len() > CHUNK * 4 / 3 + 4 {
+            return Err(fail("TOO_LARGE", "chunk exceeds limit"));
+        }
+        let data = STANDARD.decode(encoded).map_err(|e| fail("INVALID_ARGUMENT", e))?;
+        if data.len() > CHUNK || s.size + data.len() as u64 > MAX_FILE {
+            return Err(fail("TOO_LARGE", "write exceeds limit"));
+        }
+        s.file.write_all(&data).map_err(io)?;
+        s.size += data.len() as u64;
+        Ok(json!({"written":data.len()}))
+    }
+}
+fn text<'a>(v: &'a Value, key: &str) -> Result<&'a str> {
+    v.get(key)
+        .and_then(Value::as_str)
+        .filter(|s| !s.is_empty())
+        .ok_or_else(|| fail("INVALID_ARGUMENT", format!("{key} required")))
+}
+fn relative(path: &str, allow_root: bool) -> Result<String> {
+    if path.is_empty() && allow_root {
+        return Ok(String::new());
+    }
+    if path.len() > 4096
+        || path.is_empty()
+        || path.contains(['\\', ':', '\0'])
+        || path.chars().any(char::is_control)
+        || path.split('/').any(|v| {
+            v.is_empty() || matches!(v, "." | "..") || v.ends_with([' ', '.']) || {
+                let stem = v.split('.').next().unwrap_or("").to_ascii_uppercase();
+                matches!(stem.as_str(), "CON" | "PRN" | "AUX" | "NUL")
+                    || (stem.len() == 4
+                        && (stem.starts_with("COM") || stem.starts_with("LPT"))
+                        && matches!(stem.as_bytes()[3], b'1'..=b'9'))
+            }
+        })
+    {
+        return Err(fail("INVALID_PATH", "use a confined relative path"));
+    }
+    Ok(path.into())
+}
+fn hash_file(file: &mut File) -> Result<String> {
+    let mut hash = Sha256::new();
+    let mut buffer = vec![0; CHUNK];
+    let mut size = 0u64;
+    loop {
+        let n = file.read(&mut buffer).map_err(io)?;
+        if n == 0 {
+            break;
+        }
+        size += n as u64;
+        if size > MAX_FILE {
+            return Err(fail("TOO_LARGE", "file exceeds limit"));
+        }
+        hash.update(&buffer[..n]);
+    }
+    Ok(format!("{:x}", hash.finalize()))
+}
+fn open_regular(dir: &Dir, path: &str) -> Result<File> {
+    let mut options = OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use cap_std::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NONBLOCK);
+    }
+    let file = dir.open_with(path, &options).map_err(io)?.into_std();
+    if !file.metadata().map_err(io)?.is_file() {
+        return Err(fail("INVALID_ARGUMENT", "not a regular file"));
+    }
+    Ok(file)
+}
+fn etag(dir: &Dir, path: &str) -> Result<Option<String>> {
+    match open_regular(dir, path) {
+        Ok(mut file) => Ok(Some(hash_file(&mut file)?)),
+        Err(e) if e.starts_with("[NOT_FOUND]") => Ok(None),
+        Err(e) => Err(e),
+    }
+}
+#[cfg(unix)]
+fn identity(dir: &Dir) -> Result<String> {
+    use std::os::unix::fs::MetadataExt;
+    let m = dir.try_clone().map_err(io)?.into_std_file().metadata().map_err(io)?;
+    Ok(format!("{}:{}", m.dev(), m.ino()))
+}
+#[cfg(windows)]
+fn identity(dir: &Dir) -> Result<String> {
+    use std::{mem, os::windows::io::AsRawHandle};
+    use windows_sys::Win32::Storage::FileSystem::{GetFileInformationByHandle, BY_HANDLE_FILE_INFORMATION};
+    let file = dir.try_clone().map_err(io)?.into_std_file();
+    let mut info: BY_HANDLE_FILE_INFORMATION = unsafe { mem::zeroed() };
+    if unsafe { GetFileInformationByHandle(file.as_raw_handle(), &mut info) } == 0 {
+        return Err(io(std::io::Error::last_os_error()));
+    }
+    Ok(format!("{}:{}:{}", info.dwVolumeSerialNumber, info.nFileIndexHigh, info.nFileIndexLow))
+}
+
