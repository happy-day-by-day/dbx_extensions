diff --git a/apps/desktop/src/components/plugins/PluginDirectoryAccessSection.vue b/apps/desktop/src/components/plugins/PluginDirectoryAccessSection.vue
new file mode 100644
index 0000000..ac9d5a9
--- /dev/null
+++ b/apps/desktop/src/components/plugins/PluginDirectoryAccessSection.vue
@@ -0,0 +1,66 @@
+<script setup lang="ts">
+import { computed, ref, watch } from "vue";
+import { useI18n } from "vue-i18n";
+import { invoke } from "@tauri-apps/api/core";
+import { isTauriRuntime } from "@/lib/backend/tauriRuntime";
+import { Button } from "@/components/ui/button";
+import type { InstalledPlugin } from "@/types/database";
+import type { PluginDirectoryGrant } from "@/types/pluginDirectory";
+const props = defineProps<{ plugin: InstalledPlugin }>();
+const { locale } = useI18n();
+const zh = computed(() => locale.value.startsWith("zh"));
+const grants = ref<PluginDirectoryGrant[]>([]);
+const error = ref("");
+const busy = ref(false);
+const declared = computed(() => (props.plugin.manifest.permissions || []).some((p) => p.startsWith("host.directory:")));
+async function load() {
+  if (!isTauriRuntime()) return;
+  const id = props.plugin.manifest.id;
+  try {
+    const result = await invoke<PluginDirectoryGrant[]>("plugin_directory_manage", { pluginId: id });
+    if (id === props.plugin.manifest.id) grants.value = result;
+  } catch (e) {
+    if (id === props.plugin.manifest.id) error.value = String(e);
+  }
+}
+async function revoke(id: string) {
+  busy.value = true;
+  error.value = "";
+  const pluginId = props.plugin.manifest.id;
+  try {
+    const result = await invoke<PluginDirectoryGrant[]>("plugin_directory_manage", { pluginId, revokeId: id });
+    if (pluginId === props.plugin.manifest.id) grants.value = result;
+  } catch (e) {
+    error.value = String(e);
+  } finally {
+    busy.value = false;
+  }
+}
+watch(
+  () => props.plugin.manifest.id,
+  () => {
+    grants.value = [];
+    error.value = "";
+    void load();
+  },
+  { immediate: true },
+);
+</script>
+<template>
+  <section v-if="isTauriRuntime() && (declared || grants.length)" class="space-y-2 rounded-lg border p-3">
+    <div class="flex items-center justify-between gap-3">
+      <h3 class="text-sm font-semibold">{{ zh ? "目录访问授权" : "Directory access" }}</h3>
+      <Button variant="ghost" size="sm" :disabled="busy" @click="load">{{ zh ? "刷新" : "Refresh" }}</Button>
+    </div>
+    <p class="text-xs text-muted-foreground">{{ zh ? "仅可访问用户通过系统选择器授权的目录。授权跨重启保留，可随时在此撤销；撤销不会删除文件。" : "Only directories selected in the native picker are accessible. Grants survive restarts. Revoking access keeps your files." }}</p>
+    <p v-if="error" class="break-all text-xs text-destructive" role="alert">{{ error }}</p>
+    <p v-if="!grants.length" class="text-xs text-muted-foreground">{{ zh ? "尚无已授权目录" : "No authorized directories" }}</p>
+    <div v-for="grant in grants" :key="grant.id" class="flex items-center gap-3 border-t pt-2">
+      <div class="min-w-0 flex-1">
+        <p class="break-all font-mono text-xs">{{ grant.displayPath }}</p>
+        <p class="text-xs text-muted-foreground">{{ grant.mode === "readwrite" ? (zh ? "读取与写入" : "Read and write") : zh ? "只读" : "Read only" }}</p>
+      </div>
+      <Button variant="outline" size="sm" :disabled="busy" @click="revoke(grant.id)">{{ zh ? "撤销" : "Revoke" }}</Button>
+    </div>
+  </section>
+</template>
