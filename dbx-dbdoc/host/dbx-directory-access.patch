+/** Host API 1.5: native, persistent directory capabilities. Paths are relative. */
+export interface PluginDirectoryGrant {
+  id: string;
+  displayName: string;
+  displayPath: string;
+  mode: "read" | "readwrite";
+  status: "unchecked" | "ready" | "unavailable" | "identityChanged" | "revoked";
+  persistent: boolean;
+  preferred: boolean;
+  createdAt: number;
+  chunkBytes: number;
+  maxFileBytes: number;
+}
+export type PluginDirectoryOperation = "listGrants" | "setPreferred" | "restore" | "revoke" | "list" | "stat" | "mkdir" | "openRead" | "read" | "close" | "beginWrite" | "write" | "commit" | "abort";
+export interface PluginDirectoryRequest {
+  mode: "read" | "readwrite";
+  persistence?: "required" | "preferred";
+  initialPath?: string;
+}
