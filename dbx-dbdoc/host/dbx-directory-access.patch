diff --git a/apps/desktop/src/lib/plugins/pluginDirectory.spec.ts b/apps/desktop/src/lib/plugins/pluginDirectory.spec.ts
new file mode 100644
index 0000000..f38c71b
--- /dev/null
+++ b/apps/desktop/src/lib/plugins/pluginDirectory.spec.ts
@@ -0,0 +1,65 @@
+// @vitest-environment happy-dom
+import { describe, expect, it, vi } from "vitest";
+import { PluginHostBridge, pluginSdkSource } from "./pluginHostBridge";
+import type { InstalledPlugin, PluginWorkbenchContribution } from "@/types/database";
+function fixture(permissions: string[], implemented = true) {
+  const messages: any[] = [];
+  const target = { postMessage: (m: unknown) => messages.push(m) } as unknown as Window;
+  const plugin: InstalledPlugin = { manifest: { id: "own.plugin", name: "Own", version: "1.0.0", permissions, drivers: [], contributions: [] }, compatibility: { compatible: true } };
+  const contribution: PluginWorkbenchContribution = { type: "workbench", id: "own.plugin.main", label: "Test" };
+  const requestDirectory = vi.fn().mockResolvedValue({ id: "grant" });
+  const directoryCall = vi.fn().mockResolvedValue({ status: "ready" });
+  const bridge = new PluginHostBridge(plugin, contribution, {}, () => target, { invoke: vi.fn(), notify: vi.fn(), sendBinary: vi.fn(), readAsset: vi.fn(), ...(implemented ? { requestDirectory, directoryCall } : {}) });
+  const send = async (method: string, params = {}) => {
+    const count = messages.length;
+    bridge.handleWindowMessage({ source: target, data: { source: "dbx-plugin", version: 1, type: "request", id: String(count), method: `host.directory.${method}`, params } } as MessageEvent);
+    await vi.waitFor(() => expect(messages.length).toBe(count + 1));
+    return messages[messages.length - 1];
+  };
+  return { bridge, messages, send, requestDirectory, directoryCall };
+}
+describe("persistent directory bridge", () => {
+  it("advertises only an implemented host capability", async () => {
+    for (const implemented of [true, false]) {
+      const f = fixture([], implemented);
+      f.bridge.sendInit();
+      await vi.waitFor(() => expect(f.messages.length).toBeGreaterThan(0));
+      expect(f.messages[0].capabilities.directoryAccess).toBe(implemented);
+    }
+  });
+  it("requires declared read and write permissions before requesting native consent", async () => {
+    const denied = fixture([]);
+    expect((await denied.send("request", { mode: "readwrite" })).error).toContain("host.directory:read");
+    const read = fixture(["host.directory:read"]);
+    expect((await read.send("request", { mode: "readwrite" })).error).toContain("host.directory:write");
+    expect(denied.requestDirectory).not.toHaveBeenCalled();
+    expect(read.requestDirectory).not.toHaveBeenCalled();
+  });
+  it.each(["beginWrite", "write", "commit", "mkdir"])("requires write permission for %s", async (operation) => {
+    const f = fixture(["host.directory:read"]);
+    expect((await f.send(operation, { grantId: "g" })).error).toContain("host.directory:write");
+    expect(f.directoryCall).not.toHaveBeenCalled();
+  });
+  it("passes the trusted owner rather than a plugin-supplied identity", async () => {
+    const f = fixture(["host.directory:read", "host.directory:write"]);
+    await f.send("restore", { grantId: "g", pluginId: "victim" });
+    expect(f.directoryCall).toHaveBeenCalledWith("own.plugin", "restore", { grantId: "g", pluginId: "victim" });
+    await f.send("request", { mode: "readwrite", pluginId: "victim", initialPath: "/hint" });
+    expect(f.requestDirectory).toHaveBeenCalledWith("own.plugin", { mode: "readwrite", persistence: "required", initialPath: "/hint" });
+  });
+  it("preserves typed native failure codes and rejects unknown operations", async () => {
+    const f = fixture(["host.directory:read"]);
+    f.directoryCall.mockRejectedValueOnce(new Error("[REVOKED] revoked"));
+    expect((await f.send("read", { handleId: "h", offset: 0 })).error).toContain("[REVOKED]");
+    expect((await f.send("deleteEverything")).error).toContain("[UNSUPPORTED]");
+  });
+  it("does not pretend browser hosts support persistent access", async () => {
+    const f = fixture(["host.directory:read"], false);
+    expect((await f.send("restore", { grantId: "g" })).error).toContain("[UNSUPPORTED]");
+  });
+  it("exposes every operation in the sandbox SDK", () => {
+    const source = pluginSdkSource();
+    for (const operation of ["request", "listGrants", "setPreferred", "restore", "revoke", "list", "stat", "mkdir", "openRead", "read", "close", "beginWrite", "write", "commit", "abort"]) expect(source).toContain(`host.directory.${operation}`);
+    new Function(source); // Validate the injected SDK's generated JavaScript.
+  });
+});
diff --git a/apps/desktop/src/lib/plugins/pluginDirectory.ts b/apps/desktop/src/lib/plugins/pluginDirectory.ts
