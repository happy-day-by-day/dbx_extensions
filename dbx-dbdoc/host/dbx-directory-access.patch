@@ -0,0 +1,145 @@
+//! Desktop adapter for generic persistent directory capabilities.
+//! Native dialogs anchor consent; the opaque iframe never supplies a root path.
+use super::connection::AppState;
+use dbx_directory_access::DirectoryService;
+use serde_json::{json, Value};
+use std::sync::{Arc, Mutex};
+use tauri::{Manager, State};
+use tauri_plugin_dialog::DialogExt;
+
+#[derive(Default)]
+pub struct PluginDirectoryState(Arc<Mutex<Option<DirectoryService>>>);
+fn principal(state: &AppState, plugin_id: &str, write: bool) -> Result<(String, String), String> {
+    let plugin = state.plugins.find_plugin(plugin_id)?.ok_or("[NEEDS_AUTHORIZATION] Plugin is not installed")?;
+    if !plugin.compatibility.compatible {
+        return Err("[NEEDS_AUTHORIZATION] Plugin is incompatible".into());
+    }
+    let permission = if write { "host.directory:write" } else { "host.directory:read" };
+    if !plugin.manifest.permissions.iter().any(|p| p == permission) {
+        return Err(format!("[ACCESS_DENIED] Missing {permission}"));
+    }
+    // Provenance comes from the installer, not the plugin request. A publisher
+    // or signing-key change cannot inherit a previous installation's grants.
+    let owner = json!([
+        plugin.manifest.id,
+        plugin.manifest.publisher,
+        plugin.provenance.as_ref().and_then(|p| p.signing_key_id.as_ref()),
+        plugin.provenance.as_ref().and_then(|p| p.repository_id.as_ref())
+    ])
+    .to_string();
+    Ok((owner, plugin.manifest.name))
+}
+fn with_service<T>(
+    app: &tauri::AppHandle,
+    state: &Mutex<Option<DirectoryService>>,
+    f: impl FnOnce(&mut DirectoryService) -> Result<T, String>,
+) -> Result<T, String> {
+    let mut service = state.lock().map_err(|_| "[IO_ERROR] Directory service lock poisoned")?;
+    if service.is_none() {
+        let path = app.path().app_data_dir().map_err(|e| e.to_string())?.join("directory-grants/grants.json");
+        *service = Some(DirectoryService::open(path)?);
+    }
+    f(service.as_mut().unwrap())
+}
+#[tauri::command]
+pub async fn plugin_directory_request(
+    app: tauri::AppHandle,
+    state: State<'_, Arc<AppState>>,
+    directories: State<'_, PluginDirectoryState>,
+    plugin_id: String,
+    options: Value,
+) -> Result<Value, String> {
+    let mode = options.get("mode").and_then(Value::as_str).unwrap_or("read");
+    if !matches!(mode, "read" | "readwrite") {
+        return Err("[INVALID_ARGUMENT] Invalid directory mode".into());
+    }
+    let (owner, name) = principal(&state, &plugin_id, mode == "readwrite")?;
+    let title = if crate::current_app_locale(&app).starts_with("zh") {
+        let access = if mode == "readwrite" { "读写" } else { "读取" };
+        format!("授权「{name}」{access}所选目录及内容（重启后保留，可撤销）")
+    } else {
+        let access = if mode == "readwrite" { "read and write" } else { "read" };
+        format!("{name} — select directory to {access} (persists until revoked)")
+    };
+    let mut dialog = app.dialog().file().set_title(title);
+    // A typed path is only a picker hint. The grant always uses its native result.
+    if let Some(path) = options.get("initialPath").and_then(Value::as_str).filter(|p| p.len() <= 4096) {
+        dialog = dialog.set_directory(path);
+    }
+    let (tx, rx) = tokio::sync::oneshot::channel();
+    dialog.pick_folder(move |path| {
+        let _ = tx.send(path);
+    });
+    let Some(path) = rx.await.map_err(|e| e.to_string())? else { return Ok(Value::Null) };
+    let path = path.into_path().map_err(|e| e.to_string())?;
+    let (current_owner, _) = principal(&state, &plugin_id, mode == "readwrite")?;
+    if current_owner != owner {
+        return Err("[NEEDS_AUTHORIZATION] Plugin identity changed".into());
+    }
+    let mode = mode.to_owned();
+    let directories = directories.0.clone();
+    tauri::async_runtime::spawn_blocking(move || {
+        with_service(&app, &directories, |service| service.grant(&owner, &path, &mode))
+    })
+    .await
+    .map_err(|e| e.to_string())?
+}
+#[tauri::command]
+pub async fn plugin_directory_call(
+    app: tauri::AppHandle,
+    state: State<'_, Arc<AppState>>,
+    directories: State<'_, PluginDirectoryState>,
+    plugin_id: String,
+    operation: String,
+    params: Value,
+) -> Result<Value, String> {
+    // Close/abort/revoke remain possible for a read-only plugin. Every write
+    // chunk and commit rechecks both the manifest and the persisted grant.
+    let write = matches!(operation.as_str(), "beginWrite" | "write" | "commit" | "mkdir");
+    let (owner, _) = principal(&state, &plugin_id, write)?;
+    let directories = directories.0.clone();
+    tauri::async_runtime::spawn_blocking(move || {
+        with_service(&app, &directories, |service| service.call(&owner, &operation, &params))
+    })
+    .await
+    .map_err(|e| e.to_string())?
+}
+
+/// Only the trusted Plugin Center calls this; no SDK route exists. Includes
+/// grants from prior signing identities so users can revoke them after updates.
+#[tauri::command]
+pub async fn plugin_directory_manage(
+    app: tauri::AppHandle,
+    directories: State<'_, PluginDirectoryState>,
+    plugin_id: String,
+    revoke_id: Option<String>,
+) -> Result<Value, String> {
+    let directories = directories.0.clone();
+    tauri::async_runtime::spawn_blocking(move || {
+        with_service(&app, &directories, |service| {
+            let own = service
+                .inspect_grants()
+                .into_iter()
+                .filter(|(owner, _)| {
+                    serde_json::from_str::<Value>(owner)
+                        .ok()
+                        .and_then(|v| v.get(0).and_then(Value::as_str).map(str::to_owned))
+                        .as_deref()
+                        == Some(plugin_id.as_str())
+                })
+                .collect::<Vec<_>>();
+            if let Some(id) = &revoke_id {
+                let (owner, grant) = own
+                    .iter()
+                    .find(|(_, g)| g["id"].as_str() == Some(id.as_str()))
+                    .ok_or("[NEEDS_AUTHORIZATION] Unknown grant")?;
+                service.call(owner, "revoke", &json!({"grantId":grant["id"]}))?;
+            }
+            Ok(Value::Array(
+                own.into_iter().filter(|(_, g)| g["id"].as_str() != revoke_id.as_deref()).map(|(_, g)| g).collect(),
+            ))
+        })
+    })
+    .await
+    .map_err(|e| e.to_string())?
+}
