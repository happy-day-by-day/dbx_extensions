{
  "profile": "product-admin",
  "sourceRoots": ["src/ui"],
  "locale": "zh-CN",
  "canonicalMap": "DESIGN.md",
  "requiredCapabilities": ["Table Selection", "Select/Listbox", "Scrollbar"],
  "ownership": { "Select/Listbox": "native" },
  "requiredCommands": ["typecheck", "unit", "build"],
  "commands": {
    "typecheck": "npm run check",
    "unit": "npm test -- --maxWorkers 1 --minWorkers 1",
    "build": "npm run build"
  }
}
